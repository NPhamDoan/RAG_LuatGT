# ============================== LLM ==============================
# Cach dung: (1) dien key + model cho cac provider ban co o CATALOG ben duoi;
#            (2) chon provider cho tung vai tro o muc "CHON PROVIDER" - chi dien TEN.
# Doi LLM = chi sua PRIMARY_LLM_PROVIDER / VERIFY_LLM_PROVIDER, KHONG dung toi model/key.

# ----- CATALOG (khai bao 1 lan cho moi provider) -----
# Groq (cloud; gpt-oss/qwen3 la model REASONING)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
# reasoning_effort: low = nhe/tiet kiem TPM nhung doc luot (kem chinh xac);
#   medium/high = chinh xac hon, ton token hon; "" = de model tu quyet.
GROQ_REASONING_EFFORT=medium

# Mistral (cloud; free tier: console.mistral.ai)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Cohere (cloud; free trial: dashboard.cohere.com)
COHERE_API_KEY=
COHERE_MODEL=command-r-08-2024

# Gemini (cloud; thuong dung cho VERIFY)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Ollama (local; ollama serve + ollama pull <model>)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=180          # CPU cham -> de cao
OLLAMA_THINK=false          # qwen3: tat suy luan an de phan hoi nhanh hon

# ----- Tinh chung cho provider CLOUD -----
# max_tokens: voi model REASONING (Groq gpt-oss) phai du cho CA suy luan LAN cau tra loi.
#   Thap qua -> content RONG; cao qua -> prompt+max_tokens vuot TPM (free-tier Groq = 8000) -> loi 413.
LLM_MAX_TOKENS=3500
LLM_TIMEOUT=30

# ----- CHON PROVIDER CHO TUNG VAI TRO (chi dien TEN) -----
PRIMARY_LLM_PROVIDER=groq      # groq | mistral | cohere | ollama
VERIFY_LLM_PROVIDER=gemini     # gemini | groq | mistral | cohere | ollama

# === Embedding ===
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# === ChromaDB ===
CHROMA_PERSIST_DIRECTORY=./data/chroma

# === Query ===
RETRIEVAL_TOP_K=8
SIMILARITY_THRESHOLD_MIN=0.3
SIMILARITY_THRESHOLD_CONFIDENT=0.5
SYNTHESIS_MAX_CHARS_PER_CHUNK=5000
SYNTHESIS_PROMPT=full

# === Phase 4 enrich (index-time) ===
# Bat enrich: INDEX_STEPS=enrich. Nguon text enrich:
#   ENRICH_SOURCE=llm   -> goi LLM sinh enrich (ENRICH_LLM_PROVIDER=groq|ollama, bo trong=LLM chinh)
#   ENRICH_SOURCE=file  -> doc tu JSONL soan san (vd NotebookLM); KHONG goi LLM
#                          ENRICH_FILE=enrich_data.jsonl (tuong doi so voi goc repo)
# Tao file: python export_chunks_for_enrich.py -> dien truong "enrich" -> seed_data.py --reset
ENRICH_SOURCE=llm
ENRICH_FILE=
ENRICH_LLM_PROVIDER=
ENRICH_LLM_MODEL=
ENRICH_OLLAMA_BASE_URL=http://localhost:11434
ENRICH_LLM_TIMEOUT=120
ENRICH_CONCURRENCY=3
ENRICH_OLLAMA_THINK=false

# === Logging ===
LOG_LEVEL=INFO
# Khi debug LLM: đổi LOG_LEVEL=DEBUG và đặt LOG_FILE=./logs/backend.log.
# Prompt + response đầy đủ của các provider sẽ được ghi vào file này.
# Không bật DEBUG khi chia sẻ log vì nội dung có thể chứa câu hỏi/dữ liệu pháp luật.
LOG_FILE=
# === Phase logging ===
# LOG_PHASES la danh sach ten phase, phan cach bang dau phay:
#   all       = bat trace cua tat ca phase (mac dinh)
#   none      = tat trace phase
#   pipeline  = luong chinh: bat dau query, embed/retrieval, gating, synthesis
#   <step>    = trace cua query step duoc bat trong QUERY_STEPS
#               (ten phase chinh la ten truoc hau to "_step", vd normalize)
# Cac phase step co the dung tuy branch/delivery:
#   normalize  = chuan hoa cau hoi truoc khi retrieval
#   help_intent= nhan dien cau hoi hoi dap/huong dan
#   verify     = xac minh cau tra loi sau synthesis
#   enrich     = lam giau chunk luc index (neu duoc ghi trace)
# Vi du:
#   LOG_PHASES=pipeline       -> chi log luong chinh
#   LOG_PHASES=pipeline,normalize,verify -> log nhieu phase cu the
#   LOG_PHASES=none           -> tat trace "[phase:...]"
# Luu y: log prompt/response day du cua LLM can LOG_LEVEL=DEBUG, khong phu thuoc LOG_PHASES.
LOG_PHASES=all

# === Auth admin (chi mat khau) ===
# TRONG = TAT auth (route ghi mo cong khai, chi dung khi dev).
# Bat auth: tao hash bang  python -m app.api.auth "mat_khau_cua_ban"  roi dan vao day.
# Hash vi du duoi la cua mat khau "admin123" - DOI truoc khi deploy.
ADMIN_PASSWORD_HASH=pbkdf2_sha256$200000$84f8cad720b933406502e6eb6bf40e41$2b52bb55e1412251bb2020d99e3fc3fb97103563cb90fa086fbc8eb92e25c75c
# Chuoi ngau nhien de ky token - PHAI doi: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=doi-thanh-chuoi-ngau-nhien-dai
AUTH_TOKEN_TTL=28800
